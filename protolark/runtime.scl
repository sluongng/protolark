"""Shared validation and construction for generated protobuf configurations.

Bazel's pure .scl dialect (including PROJECT.scl) only loads other .scl files
through same-repository //... labels; it rejects .bzl files and @repo labels.
For native .scl evaluation, keep a copy of this file in the consuming repository
and use //protolark:runtime.scl, or set the generator's runtime_load label to its
local location. Generated .bzl files instead load the external runtime.bzl wrapper,
which re-exports this implementation. The standalone Protolark evaluator bundles
this source and supplies both standard runtime labels without a local copy.
Keep runtime copies and generated constructors on the same Protolark version.
"""

# Constructors omit unspecified/None fields. Message values are structs;
# message identity is not validated. Bytes strings use protobuf JSON base64.

def _protolark_scalar(value, kind, label, allowed):
    actual = type(value)
    if kind == "message":
        if actual != "struct":
            fail(label + ": expected struct")
    elif kind == "string" or kind == "bytes":
        if actual != "string":
            fail(label + ": expected string")
    elif kind == "bool":
        if actual != "bool":
            fail(label + ": expected bool")
    elif kind == "float" or kind == "double":
        # Bazel accepts integers; embedded interpreters may also support floats.
        if actual != "int" and actual != "float":
            fail(label + ": expected int or float")
    elif kind == "enum":
        if actual != "int" or value not in allowed:
            fail(label + ": expected a declared enum number")
    else:
        if actual != "int":
            fail(label + ": expected int")
        bounds = {
            "int32": (-2147483648, 2147483647),
            "sint32": (-2147483648, 2147483647),
            "sfixed32": (-2147483648, 2147483647),
            "uint32": (0, 4294967295),
            "fixed32": (0, 4294967295),
            "int64": (-9223372036854775808, 9223372036854775807),
            "sint64": (-9223372036854775808, 9223372036854775807),
            "sfixed64": (-9223372036854775808, 9223372036854775807),
            "uint64": (0, 18446744073709551615),
            "fixed64": (0, 18446744073709551615),
        }
        lower, upper = bounds[kind]
        if value < lower or value > upper:
            fail(label + ": integer out of range for " + kind)

def create_message(name, specs, kwargs):
    """Validates schema-defined fields and returns a protobuf configuration struct.

    Args:
        name: Fully qualified protobuf message name, used in diagnostics.
        specs: Field specifications emitted by the matching Protolark generator.
        kwargs: Field values supplied by the configuration author.

    Returns:
        A struct containing the supplied, validated fields.
    """
    result = {}
    oneofs = {}
    for key in kwargs:
        if key not in specs:
            fail(name + ": unknown field " + key)
    for key, spec in specs.items():
        kind, repeated, required, oneof, allowed, map_key, map_value, map_allowed = spec
        value = kwargs.get(key)
        label = name + "." + key
        if value == None:
            if required:
                fail(label + ": required field missing")
            continue
        if oneof != "":
            if oneof in oneofs:
                fail(name + ": multiple fields in oneof " + oneof)
            oneofs[oneof] = key
        if map_key != "":
            if type(value) != "dict":
                fail(label + ": expected dict")
            for k, v in value.items():
                _protolark_scalar(k, map_key, label + " key", [])
                _protolark_scalar(v, map_value, label + " value", map_allowed)
            result[key] = dict(value)
        elif repeated:
            if type(value) != "list" and type(value) != "tuple":
                fail(label + ": expected list or tuple")
            for item in value:
                _protolark_scalar(item, kind, label + " item", allowed)
            result[key] = list(value)
        else:
            _protolark_scalar(value, kind, label, allowed)
            result[key] = value
    _validate_wkt(name, result)
    return struct(**result)

def _finite(value):
    # Avoid float literals/builtins, which pure Bazel Starlark does not expose.
    return value == value and value - value == 0

def _validate_wkt(name, fields):
    if name == "google.protobuf.Timestamp":
        seconds = fields.get("seconds", 0)
        nanos = fields.get("nanos", 0)
        if seconds < -62135596800 or seconds > 253402300799:
            fail(name + ".seconds: must be between -62135596800 and 253402300799")
        if nanos < 0 or nanos > 999999999:
            fail(name + ".nanos: must be between 0 and 999999999")
    elif name == "google.protobuf.Duration":
        seconds = fields.get("seconds", 0)
        nanos = fields.get("nanos", 0)
        if seconds < -315576000000 or seconds > 315576000000:
            fail(name + ".seconds: must be between -315576000000 and 315576000000")
        if nanos < -999999999 or nanos > 999999999:
            fail(name + ".nanos: must be between -999999999 and 999999999")
        if (seconds < 0 and nanos > 0) or (seconds > 0 and nanos < 0):
            fail(name + ": seconds and nanos must have consistent signs")
    elif name == "google.protobuf.Value":
        kinds = [key for key in fields if key in ["null_value", "number_value", "string_value", "bool_value", "struct_value", "list_value"]]
        if len(kinds) != 1:
            fail(name + ": exactly one kind must be selected")
        if "number_value" in fields and not _finite(fields["number_value"]):
            fail(name + ".number_value: must be finite")

_TIME_SPECS = {
    "seconds": ("int64", False, False, "", [], "", "", []),
    "nanos": ("int32", False, False, "", [], "", "", []),
}

def _timestamp(seconds = 0, nanos = 0):
    return create_message("google.protobuf.Timestamp", _TIME_SPECS, {"seconds": seconds, "nanos": nanos})

def _duration(seconds = 0, nanos = 0):
    return create_message("google.protobuf.Duration", _TIME_SPECS, {"seconds": seconds, "nanos": nanos})

def _value(value):
    """Converts native JSON-like data to Value, with at most 20 container levels."""

    # Build breadth-first layers, then reconstruct from the leaves. Neither
    # recursion nor while loops are available in pure Bazel Starlark. The bound
    # also rejects cyclic lists/dicts supported by some embedded interpreters.
    # Each native container adds three structural levels; 20 fits the standalone
    # evaluator's depth limit of 64.
    layers = [[value]]
    scheduled = 1
    for depth in range(21):
        children = []
        for item in layers[-1]:
            actual = type(item)
            if actual in ["dict", "list", "tuple"]:
                if depth == 20:
                    fail("wkt.value: maximum nesting depth is 20 containers")

                # Count expanded values, not input identities: small shared DAGs
                # can otherwise expand exponentially into protobuf trees.
                scheduled += len(item)
                if scheduled > 100000:
                    fail("wkt.value: maximum expanded value count is 100000")
            if actual == "dict":
                for key in item:
                    if type(key) != "string":
                        fail("wkt.value: dict keys must be strings")
                children.extend(item.values())
            elif actual == "list" or actual == "tuple":
                children.extend(item)
        if not children:
            break
        layers.append(children)

    converted = []
    for layer in reversed(layers):
        parents = []
        offset = 0
        for item in layer:
            actual = type(item)
            if actual == "dict":
                fields = {}
                for key in item:
                    fields[key] = converted[offset]
                    offset += 1
                parents.append(struct(struct_value = struct(fields = fields)))
            elif actual == "list" or actual == "tuple":
                parents.append(struct(list_value = struct(values = converted[offset:offset + len(item)])))
                offset += len(item)
            elif item == None:
                parents.append(struct(null_value = 0))
            elif actual == "bool":
                parents.append(struct(bool_value = item))
            elif actual == "string":
                parents.append(struct(string_value = item))
            elif actual == "int" or actual == "float":
                if not _finite(item):
                    fail("wkt.value: numbers must be finite")
                if actual == "int" and (item < -9007199254740991 or item > 9007199254740991):
                    fail("wkt.value: integers must be within the exact double range [-9007199254740991, 9007199254740991]")
                parents.append(struct(number_value = item))
            else:
                fail("wkt.value: unsupported type " + actual)
        converted = parents
    return converted[0]

def _struct(value):
    if type(value) != "dict":
        fail("wkt.struct: expected dict")
    return _value(value).struct_value

def _list_value(value):
    if type(value) != "list" and type(value) != "tuple":
        fail("wkt.list_value: expected list or tuple")
    return _value(value).list_value

# Helpers return the same structural messages as generated constructors. None
# represents explicit JSON null only inside value/struct/list_value conversion.
# Integers for Value must be in the safe IEEE-754 double range; pass larger
# identifiers as strings. Embedded interpreters may also supply finite floats.
wkt = struct(
    timestamp = _timestamp,
    duration = _duration,
    value = _value,
    struct = _struct,
    list_value = _list_value,
)
