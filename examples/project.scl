load(":project_generated.bzl", "common_proto", "project_proto")

project = project_proto.Project.create(
    name = "example",
    targets = ["//app:all", "//tests:all"],
    labels = {"team": "build"},
    owner = common_proto.Owner.create(name = "Maintainer"),
    enabled = True,
    local_path = "workspace",
    mode = project_proto.Project.Mode.FAST,
    settings = project_proto.Project.Settings.create(timeout_seconds = 30),
)
